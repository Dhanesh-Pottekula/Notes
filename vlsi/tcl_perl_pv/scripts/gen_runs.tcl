#!/usr/bin/env tclsh
# gen_runs.tcl - make one run directory and one SVRF header file per block, then launch DRC.
# usage: tclsh gen_runs.tcl blocks.list <run_root> [-run]
#   without -run it only writes the files and prints the commands (a "dry run")
# blocks.list line:  <block>  <gds file>  <top cell>         (# starts a comment)

# The header that changes per block. @NAME@ markers are replaced with [string map].
set template {// generated by gen_runs.tcl - do not edit by hand
LAYOUT SYSTEM GDSII
LAYOUT PATH    "@GDS@"
LAYOUT PRIMARY "@TOP@"
DRC RESULTS DATABASE "@BLOCK@.drc.results" ASCII
DRC SUMMARY REPORT   "@BLOCK@.drc.summary" REPLACE HIER
DRC MAXIMUM RESULTS 1000
INCLUDE "@RULES@"
}

if {$argc < 2} {
    puts stderr "usage: tclsh gen_runs.tcl <blocks.list> <run_root> ?-run?"
    exit 2
}
lassign $argv list_file run_root flag
set do_run [expr {$flag eq "-run"}]

# The foundry deck comes from the environment, so one script serves every project.
if {[info exists env(PV_DRC_DECK)]} {
    set rules $env(PV_DRC_DECK)
} else {
    set rules /path/to/foundry/drc.deck
}
set cpus 8

set fh [open $list_file r]
set failed {}
while {[gets $fh line] >= 0} {
    regsub {#.*} $line {} line                 ;# drop comments
    if {[llength $line] == 0} continue         ;# blank line
    if {[llength $line] != 3} {
        puts stderr "skip bad line: $line"
        continue
    }
    lassign $line block gds top

    set dir [file join $run_root $block]
    file mkdir $dir
    set svrf [file join $dir _drc_$block.svrf]
    set out [open $svrf w]
    puts -nonewline $out [string map [list @GDS@ $gds @TOP@ $top @BLOCK@ $block @RULES@ $rules] $template]
    close $out

    set cmd [list calibre -drc -hier -turbo $cpus _drc_$block.svrf]
    puts "$block: wrote $svrf"
    puts "  cd $dir && $cmd > $block.drc.log"
    if {!$do_run} continue

    # exec raises an error when the program exits non-zero, so wrap it in catch
    set here [pwd]
    cd $dir
    set status [catch {exec {*}$cmd > $block.drc.log 2>@1} msg]
    cd $here
    if {$status} {
        puts "  FAILED: $msg"
        lappend failed $block
    }
}
close $fh

if {$do_run && [llength $failed]} {
    puts "failed blocks: $failed"
    exit 1
}
